<resources>
    <attr name="arkuiHomeEditButtonStyle" format="reference" />
    <attr name="arkuiHomeEditActionStyle" format="reference" />
    <style name="ArkuiHomeEditTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="arkuiHomeEditButtonStyle">@style/Widget.Arkui.HomeEdit.Button</item>
        <item name="arkuiHomeEditActionStyle">@style/Widget.Arkui.HomeEdit.Action</item>
        <item name="colorPrimary">@color/materialColorPrimary</item>
        <item name="colorOnPrimary">@color/materialColorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/materialColorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/materialColorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/materialColorSecondary</item>
        <item name="colorOnSecondary">@color/materialColorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/materialColorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/materialColorOnSecondaryContainer</item>
        <item name="colorSurface">@color/materialColorSurface</item>
        <item name="colorOnSurface">@color/materialColorOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/materialColorOnSurfaceVariant</item>
        <item name="colorSurfaceContainerLow">@color/materialColorSurfaceContainerLow</item>
        <item name="colorSurfaceContainerHighest">@color/materialColorSurfaceContainerHighest</item>
        <item name="colorOutline">@color/materialColorOutline</item>
        <item name="colorOutlineVariant">@color/materialColorOutlineVariant</item>
        <item name="colorError">@color/materialColorError</item>
        <item name="colorOnError">@color/materialColorOnError</item>
        <item name="colorErrorContainer">@color/materialColorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/materialColorOnErrorContainer</item>
    </style>
    <style name="Widget.Arkui.HomeEdit.Button" parent="Widget.Material3Expressive.Button">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.Arkui.HomeEdit.Action" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">104dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">2</item>
        <item name="iconSize">28dp</item>
        <item name="iconPadding">8dp</item>
    </style>
</resources>
