<com.android.launcher3.views.AskAiView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arkui_ask_ai"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/arkui_ask_ai_width"
    android:minHeight="48dp"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/arkui_ask_ai_description"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/arkui_ask_ai_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:minHeight="@dimen/arkui_ask_ai_surface_height"
        android:paddingStart="@dimen/arkui_ask_ai_padding"
        android:paddingEnd="@dimen/arkui_ask_ai_padding"
        android:paddingTop="@dimen/arkui_ask_ai_vertical_padding"
        android:paddingBottom="@dimen/arkui_ask_ai_vertical_padding"
        android:gravity="center"
        android:orientation="horizontal"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/arkui_ask_ai_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/arkui_ask_ai_icon_padding"
            android:importantForAccessibility="no"
            android:src="@drawable/arkui_ic_ask_ai" />

        <TextView
            android:id="@+id/arkui_ask_ai_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:text="@string/arkui_ask_ai"
            android:textSize="14sp" />
    </LinearLayout>
</com.android.launcher3.views.AskAiView>
